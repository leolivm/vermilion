diff --git a/src/amd/common/darwin/ac_darwin_drm.c b/src/amd/common/darwin/ac_darwin_drm.c
index 317d4e40..d377ebbd 100644
--- a/src/amd/common/darwin/ac_darwin_drm.c
+++ b/src/amd/common/darwin/ac_darwin_drm.c
@@ -95,7 +95,7 @@ const struct amdgpu_device *
 acd_canned_device(void)
 {
    const char *name = getenv("RADV_DARWIN_CANNED");
-   return find_canned(name && *name ? name : "phoenix");
+   return find_canned(name && *name ? name : "navi31_xt");   /* navi31 fork: RX 7900 XT */
 }
 
 uint32_t
@@ -112,6 +112,7 @@ uint32_t
 acd_canned_gc_version(const struct amdgpu_device *d)
 {
    switch (d->dev.family) {
+   case AMDGPU_FAMILY_GC_11_0_0: return (11u << 16) | (0u << 8) | 0u;   /* Navi 31 */
    case AMDGPU_FAMILY_GC_11_0_1: return (11u << 16) | (0u << 8) | 1u;
    case AMDGPU_FAMILY_GC_12_0_0: return (12u << 16) | (0u << 8) | 1u;
    default: return 0;
@@ -365,6 +366,8 @@ acd_get_marketing_name(acd_device_handle dev)
 {
    if (!strcmp(dev->canned->name, "phoenix"))
       return "AMD Radeon 780M Graphics";
+   if (!strcmp(dev->canned->name, "navi31_xt"))
+      return "AMD Radeon RX 7900 XT";
    return ACD_MARKETING_NAME;
 }
 
