From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Vermilion contributors <vermilion@example.invalid>
Date: Wed, 4 Nov 2026 00:00:00 +0000
Subject: [PATCH 17/17] radv/darwin: navi31 shim changes on top of 0016

The uncommitted Darwin shim changes the 2026-11-04 RADV build carries
(scanout, kext connection, sync, disk cache path), exported as one patch.
---
diff --git a/include/darwin/navi48_native_abi.h b/include/darwin/navi48_native_abi.h
index 74b4468f..0ca139d5 100644
--- a/include/darwin/navi48_native_abi.h
+++ b/include/darwin/navi48_native_abi.h
@@ -192,6 +192,7 @@ struct n48n_info {                 /* 192 B */
 };
 #define N48N_INFO_HUNG          (1u << 0)
 #define N48N_INFO_S1B_POSITIVE  (1u << 1)
+#define N48N_INFO_VCN (1u << 3)
 #define N48N_INFO_NATIVE_BOOT   (1u << 2)
 /* ABI 1.10 (kext 0.0.640): n48n_info.reserved[] words (an older kext leaves them 0, which reads as "no budget reported").
  *   reserved[0],[1] = native write counter (diagnostic)   reserved[2] = ABI minor (1.1)
diff --git a/src/amd/common/ac_gpu_info.c b/src/amd/common/ac_gpu_info.c
index d734cf51..132a5058 100644
--- a/src/amd/common/ac_gpu_info.c
+++ b/src/amd/common/ac_gpu_info.c
@@ -15,6 +15,7 @@
 #include "amd_family.h"
 #include "amdgfxregs.h"
 #include "util/macros.h"
+#include <stdlib.h>
 #include "util/u_math.h"
 #include "util/os_misc.h"
 #include "util/format/u_format.h"
@@ -1640,6 +1641,13 @@ ac_query_gpu_info(int fd, void *dev_p, struct radeon_info *info,
     */
    info->discardable_allows_big_page = info->gfx_level >= GFX10_3 && info->gfx_level < GFX12 &&
                                        info->has_dedicated_vram;
+#ifdef __APPLE__
+   /* PhxBringup backs every BO, VRAM included, with scattered 4 KiB system pages and maps them without PTE fragments,
+    * so the GFX11 attribute ring must not be declared BIG_PAGE: the SPI would translate it as 64 KiB+ fragments and
+    * read other waves' varyings (garbled CoreAnimation text, 2026-10-26). RADV_BIG_PAGE=1 turns it back on. */
+   if (!(getenv("RADV_BIG_PAGE") && getenv("RADV_BIG_PAGE")[0] == '1'))
+      info->discardable_allows_big_page = false;
+#endif
 
    /* Compute the scratch WAVESIZE granularity in bytes. */
    info->scratch_wavesize_granularity_shift = info->gfx_level >= GFX11 ? 8 : 10;
