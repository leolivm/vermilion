 }
 
+int
+acd_kext_surf_gpu_mark(struct acd_kext *k, uint32_t surface_id, uint32_t plane, uint32_t *status)
+{
+   const uint64_t sin[2] = {surface_id, plane};
+   uint64_t sout[1] = {0};
+   uint32_t nout = 1;
+   int r = kcall(k, ACD_SEL_SURF_GPU_MARK, sin, 2, NULL, 0, sout, &nout, NULL, NULL);
+   if (!r && nout < 1)
+      r = -EIO;
+   if (!r)
+      *status = (uint32_t)sout[0];
+   return r;
+}
+
 /* ---- ABI 1.1 scanout ---- */
 
