 }
 
+static bool
+acd_vcn(const struct acd_device *dev)
+{
+   if (!dev->core->kext || strcmp(dev->canned->name, "navi31_xt"))
+      return false;
+   if (env_is_1("RADV_DARWIN_VCN"))
+      return true;
+   if (getenv("RADV_DARWIN_VCN"))
+      return false;
+   struct n48n_info k;
+   return !acd_kext_query_info(dev->core->kext, &k) && (k.flags & N48N_INFO_VCN);
+}
+
+static int
+acd_info_video_caps(const struct drm_amdgpu_info *info, void *out)
+{
+   struct drm_amdgpu_info_video_caps *caps = out;
+   memset(caps, 0, sizeof(*caps));
+   if (info->video_cap.type != AMDGPU_INFO_VIDEO_CAPS_DECODE)
+      return 0;
+   static const uint32_t dec[][4] = {
+      {AMDGPU_INFO_VIDEO_CAPS_CODEC_IDX_MPEG4_AVC, 4096, 4096, 52},
+      {AMDGPU_INFO_VIDEO_CAPS_CODEC_IDX_HEVC, 8192, 4352, 186},
+      {AMDGPU_INFO_VIDEO_CAPS_CODEC_IDX_JPEG, 16384, 16384, 0},
+      {AMDGPU_INFO_VIDEO_CAPS_CODEC_IDX_VP9, 8192, 4352, 0},
+      {AMDGPU_INFO_VIDEO_CAPS_CODEC_IDX_AV1, 8192, 4352, 0},
+   };
+   for (unsigned i = 0; i < ARRAY_SIZE(dec); i++) {
+      struct drm_amdgpu_info_video_codec_info *c = &caps->codec_info[dec[i][0]];
+      c->valid = 1;
+      c->max_width = dec[i][1];
+      c->max_height = dec[i][2];
+      c->max_pixels_per_frame = dec[i][1] * dec[i][2];
+      c->max_level = dec[i][3];
+   }
+   return 0;
+}
