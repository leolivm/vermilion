#version 450
// WindowServer GPU present: one display-surface pixel per invocation into a scanout slot. l10r (ARGB2101010) narrows
// to the panel's 8-bit ARGB the way the display pipe's CPU copy does; BGRA passes through.
layout(local_size_x = 256) in;
layout(std430, set = 0, binding = 0) readonly buffer Src { uint s[]; };
layout(std430, set = 0, binding = 1) writeonly buffer Dst { uint d[]; };
layout(push_constant) uniform PC { uint count; uint l10r; } pc;
void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.count) return;
    uint v = s[i];
    d[i] = pc.l10r != 0u ? (0xff000000u | ((v >> 6) & 0xff0000u) | ((v >> 4) & 0xff00u) | ((v >> 2) & 0xffu)) : v;
}
